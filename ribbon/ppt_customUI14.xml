            <button id="ltxPdfSel" label="Export PDF (selected slides)" imageMso="FileSaveAsPdfOrXps" onAction="LtxRibbon_OnAction"/>
          </menu>
          <menu id="ltxSendMenu" label="Send" image="send" size="normal">
            <button id="ltxSend" label="Email deck" imageMso="FileSendAsAttachment" onAction="LtxRibbon_OnAction"/>
            <button id="ltxSendPdf" label="Email as PDF" imageMso="FileSendAsPdfEmailAttachement" onAction="LtxRibbon_OnAction"/>
