          </menu>
          <button id="ltxDeckCheck" label="Deck Check" image="deckcheck" size="large" keytip="K" onAction="LtxRibbon_OnAction" screentip="Find empty placeholders, off-slide shapes, TBDs, stale links, font mix"/>
